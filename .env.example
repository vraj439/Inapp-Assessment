# Shared (all services)
INTERNAL_API_KEY=dev-internal-key-change-in-production

# API Gateway
USER_SERVICE_URL=http://user-service:8001
EVENT_SERVICE_URL=http://event-service:8002
INVITATION_SERVICE_URL=http://invitation-service:8003
GATEWAY_TITLE="Event Scheduling API"
GATEWAY_VERSION=1.0.0
SERVICE_NAME=api-gateway
CORS_ORIGINS=*
SERVE_FRONTEND=true
FRONTEND_DIR=/app/frontend
HTTP_TIMEOUT=30
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# User service
USERS_DATABASE_URL=postgresql+asyncpg://users:users_secret@postgres-users:5432/users_db
USER_SERVICE_NAME=user-service

# Event service
EVENTS_DATABASE_URL=postgresql+asyncpg://events:events_secret@postgres-events:5432/events_db
EVENT_SERVICE_NAME=event-service

# Invitation service
INVITATIONS_DATABASE_URL=postgresql+asyncpg://invitations:invitations_secret@postgres-invitations:5432/invitations_db
INVITATION_SERVICE_NAME=invitation-service
